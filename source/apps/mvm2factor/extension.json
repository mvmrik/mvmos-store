{
  "schema": 1,
  "enabled": true,
  "version": "1.0.6",
  "icon": "public/extension-icon.png",
  "targets": [
    "chrome",
    "firefox"
  ],
  "surface": {
    "type": "popup",
    "width": 640
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "popup_scripts": "extension/popup.js",
  "settings": [
    {
      "key": "filter_mode",
      "type": "select",
      "label": {
        "en": "Accounts shown in the extension",
        "bg": "Акаунти, показвани в разширението",
        "de": "In der Erweiterung angezeigte Konten",
        "es": "Cuentas mostradas en la extensión",
        "fr": "Comptes affichés dans l’extension",
        "ja": "拡張機能に表示するアカウント",
        "pt-BR": "Contas exibidas na extensão",
        "ru": "Аккаунты, показываемые в расширении",
        "zh-CN": "扩展中显示的账户"
      },
      "default": "matching",
      "options": [
        {
          "value": "matching",
          "label": {
            "en": "Only matching the current website",
            "bg": "Само съвпадащите с текущия сайт",
            "de": "Nur passend zur aktuellen Website",
            "es": "Solo las que coinciden con el sitio actual",
            "fr": "Uniquement ceux du site actuel",
            "ja": "現在のサイトに一致するもののみ",
            "pt-BR": "Apenas as do site atual",
            "ru": "Только для текущего сайта",
            "zh-CN": "仅与当前网站匹配的"
          }
        },
        {
          "value": "all",
          "label": {
            "en": "Show all accounts",
            "bg": "Показвай всички акаунти",
            "de": "Alle Konten anzeigen",
            "es": "Mostrar todas las cuentas",
            "fr": "Afficher tous les comptes",
            "ja": "すべてのアカウントを表示",
            "pt-BR": "Mostrar todas as contas",
            "ru": "Показывать все аккаунты",
            "zh-CN": "显示所有账户"
          }
        }
      ]
    }
  ],
  "distribution": {
    "chrome_store_url": null,
    "firefox_store_url": null
  }
}
