{
  "schema": 1,
  "enabled": true,
  "version": "1.0.2",
  "icon": "public/extension-icon.png",
  "targets": [
    "chrome",
    "firefox"
  ],
  "surface": {
    "type": "popup",
    "width": 680
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "popup_scripts": "extension/popup.js",
  "background": "extension/background.js",
  "content_scripts": [
    {
      "js": "extension/fields.js",
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    },
    {
      "js": "extension/passkey-page.js",
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "js": "extension/passkey-bridge.js",
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "open-password-manager": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Open the password vault for the current page"
    }
  },
  "min_browser_version": {
    "firefox": "128.0"
  },
  "settings": [
    {
      "key": "autofill_mode",
      "type": "select",
      "label": {
        "en": "Autofill",
        "bg": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043f\u043e\u043f\u044a\u043b\u0432\u0430\u043d\u0435"
      },
      "default": "off",
      "options": [
        {
          "value": "off",
          "label": {
            "en": "No autofill",
            "bg": "\u0411\u0435\u0437 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u043f\u043e\u043f\u044a\u043b\u0432\u0430\u043d\u0435"
          }
        },
        {
          "value": "icons",
          "label": {
            "en": "Show an icon in the fields",
            "bg": "\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u043d\u0435 \u043d\u0430 \u0438\u043a\u043e\u043d\u043a\u0430 \u0432 \u043f\u043e\u043b\u0435\u0442\u0430\u0442\u0430"
          }
        },
        {
          "value": "shortcut",
          "label": {
            "en": "Keyboard shortcut",
            "bg": "\u041a\u043b\u0430\u0432\u0438\u0448\u043d\u0430 \u043a\u043e\u043c\u0431\u0438\u043d\u0430\u0446\u0438\u044f"
          }
        }
      ]
    },
    {
      "key": "icons_on_focus",
      "type": "boolean",
      "label": {
        "en": "Show only when I click in the field",
        "bg": "\u041f\u043e\u043a\u0430\u0437\u0432\u0430\u0439 \u0441\u0430\u043c\u043e \u043f\u0440\u0438 \u043a\u043b\u0438\u043a \u0432 \u043f\u043e\u043b\u0435\u0442\u043e"
      },
      "default": false,
      "show_if": {
        "key": "autofill_mode",
        "value": "icons"
      }
    },
    {
      "key": "autofill_exclusions",
      "type": "textarea",
      "label": {
        "en": "Do not show autofill icons on these addresses",
        "bg": "\u0411\u0435\u0437 \u0438\u043a\u043e\u043d\u043a\u0438 \u0437\u0430 \u043f\u043e\u043f\u044a\u043b\u0432\u0430\u043d\u0435 \u043d\u0430 \u0442\u0435\u0437\u0438 \u0430\u0434\u0440\u0435\u0441\u0438",
        "de": "Auf diesen Adressen keine Ausf\u00fcllsymbole anzeigen",
        "es": "No mostrar iconos de autocompletar en estas direcciones",
        "fr": "Ne pas afficher les ic\u00f4nes de remplissage \u00e0 ces adresses",
        "ja": "\u3053\u308c\u3089\u306e\u30a2\u30c9\u30ec\u30b9\u3067\u81ea\u52d5\u5165\u529b\u30a2\u30a4\u30b3\u30f3\u3092\u8868\u793a\u3057\u306a\u3044",
        "pt-BR": "N\u00e3o mostrar \u00edcones de preenchimento nestes endere\u00e7os",
        "ru": "\u041d\u0435 \u043f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0437\u043d\u0430\u0447\u043a\u0438 \u0430\u0432\u0442\u043e\u0437\u0430\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u043d\u0430 \u044d\u0442\u0438\u0445 \u0430\u0434\u0440\u0435\u0441\u0430\u0445",
        "zh-CN": "\u4e0d\u5728\u8fd9\u4e9b\u5730\u5740\u663e\u793a\u81ea\u52a8\u586b\u5145\u56fe\u6807"
      },
      "hint": {
        "en": "One rule per line. site.com includes subdomains; *.site.com means subdomains only. Add a path for one page, and a scheme or port to narrow the match. Changes apply to open tabs after saving. Without http:// or https://, either protocol matches.",
        "bg": "\u041f\u043e \u0435\u0434\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u043d\u0430 \u0440\u0435\u0434. site.com \u0432\u043a\u043b\u044e\u0447\u0432\u0430 \u043f\u043e\u0434\u0434\u043e\u043c\u0435\u0439\u043d\u0438\u0442\u0435; *.site.com \u043e\u0437\u043d\u0430\u0447\u0430\u0432\u0430 \u0441\u0430\u043c\u043e \u043f\u043e\u0434\u0434\u043e\u043c\u0435\u0439\u043d\u0438\u0442\u0435. \u0414\u043e\u0431\u0430\u0432\u0438 \u043f\u044a\u0442 \u0437\u0430 \u0435\u0434\u043d\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430, \u0430 \u0441\u0445\u0435\u043c\u0430 \u0438\u043b\u0438 \u043f\u043e\u0440\u0442 \u0437\u0430 \u043f\u043e-\u0442\u043e\u0447\u043d\u043e \u0441\u044a\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u0435. \u041f\u0440\u043e\u043c\u0435\u043d\u0438\u0442\u0435 \u0432\u0430\u0436\u0430\u0442 \u0438 \u0437\u0430 \u043e\u0442\u0432\u043e\u0440\u0435\u043d\u0438\u0442\u0435 \u0442\u0430\u0431\u043e\u0432\u0435 \u0441\u043b\u0435\u0434 \u0437\u0430\u043f\u0430\u0437\u0432\u0430\u043d\u0435. \u0411\u0435\u0437 http:// \u0438\u043b\u0438 https:// \u043f\u0440\u0430\u0432\u0438\u043b\u043e\u0442\u043e \u0432\u0430\u0436\u0438 \u0438 \u0437\u0430 \u0434\u0432\u0430\u0442\u0430 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u0430.",
        "de": "Eine Regel pro Zeile. site.com schlie\u00dft Subdomains ein; *.site.com gilt nur f\u00fcr Subdomains. Ein Pfad beschr\u00e4nkt auf eine Seite, ein Schema oder Port auf eine bestimmte Verbindung. \u00c4nderungen gelten nach dem Speichern auch f\u00fcr offene Tabs. Ohne http:// oder https:// gilt die Regel f\u00fcr beide Protokolle.",
        "es": "Una regla por l\u00ednea. site.com incluye subdominios; *.site.com solo subdominios. A\u00f1ade una ruta para una p\u00e1gina y un esquema o puerto para precisar la coincidencia. Los cambios se aplican a las pesta\u00f1as abiertas al guardar. Sin http:// ni https://, la regla coincide con ambos protocolos.",
        "fr": "Une r\u00e8gle par ligne. site.com inclut les sous-domaines ; *.site.com ne vise que les sous-domaines. Ajoutez un chemin pour une page et un protocole ou port pour pr\u00e9ciser la correspondance. Les modifications s\u2019appliquent aux onglets ouverts apr\u00e8s enregistrement. Sans http:// ni https://, la r\u00e8gle correspond aux deux protocoles.",
        "ja": "1\u884c\u306b1\u3064\u306e\u30eb\u30fc\u30eb\u3002site.com \u306f\u30b5\u30d6\u30c9\u30e1\u30a4\u30f3\u3092\u542b\u307f\u3001*.site.com \u306f\u30b5\u30d6\u30c9\u30e1\u30a4\u30f3\u306e\u307f\u3067\u3059\u3002\u30d1\u30b9\u3067\u7279\u5b9a\u30da\u30fc\u30b8\u3001\u30b9\u30ad\u30fc\u30e0\u3084\u30dd\u30fc\u30c8\u3067\u5bfe\u8c61\u3092\u7d5e\u308c\u307e\u3059\u3002\u4fdd\u5b58\u5f8c\u306f\u958b\u3044\u3066\u3044\u308b\u30bf\u30d6\u306b\u3082\u53cd\u6620\u3055\u308c\u307e\u3059\u3002 http:// \u307e\u305f\u306f https:// \u3092\u7701\u304f\u3068\u3001\u3069\u3061\u3089\u306e\u30d7\u30ed\u30c8\u30b3\u30eb\u306b\u3082\u4e00\u81f4\u3057\u307e\u3059\u3002",
        "pt-BR": "Uma regra por linha. site.com inclui subdom\u00ednios; *.site.com vale apenas para subdom\u00ednios. Adicione um caminho para uma p\u00e1gina e um protocolo ou porta para restringir a correspond\u00eancia. As altera\u00e7\u00f5es se aplicam \u00e0s abas abertas ap\u00f3s salvar. Sem http:// ou https://, a regra corresponde aos dois protocolos.",
        "ru": "\u041e\u0434\u043d\u043e \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u043d\u0430 \u0441\u0442\u0440\u043e\u043a\u0443. site.com \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u043e\u0434\u0434\u043e\u043c\u0435\u043d\u044b; *.site.com \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0434\u0434\u043e\u043c\u0435\u043d\u044b. \u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0442\u044c \u0434\u043b\u044f \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b, \u0430 \u0441\u0445\u0435\u043c\u0443 \u0438\u043b\u0438 \u043f\u043e\u0440\u0442 \u0434\u043b\u044f \u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0441\u043e\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u044f. \u041f\u043e\u0441\u043b\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0442 \u0438 \u0432 \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0445 \u0432\u043a\u043b\u0430\u0434\u043a\u0430\u0445. \u0411\u0435\u0437 http:// \u0438\u043b\u0438 https:// \u043f\u0440\u0430\u0432\u0438\u043b\u043e \u043f\u043e\u0434\u0445\u043e\u0434\u0438\u0442 \u0434\u043b\u044f \u043e\u0431\u043e\u0438\u0445 \u043f\u0440\u043e\u0442\u043e\u043a\u043e\u043b\u043e\u0432.",
        "zh-CN": "\u6bcf\u884c\u4e00\u6761\u89c4\u5219\u3002site.com \u5305\u542b\u5b50\u57df\u540d\uff1b*.site.com \u4ec5\u5339\u914d\u5b50\u57df\u540d\u3002\u6dfb\u52a0\u8def\u5f84\u53ef\u9650\u5b9a\u5355\u4e2a\u9875\u9762\uff0c\u6dfb\u52a0\u534f\u8bae\u6216\u7aef\u53e3\u53ef\u7f29\u5c0f\u5339\u914d\u8303\u56f4\u3002\u4fdd\u5b58\u540e\u66f4\u6539\u4e5f\u4f1a\u5e94\u7528\u4e8e\u5df2\u6253\u5f00\u7684\u6807\u7b7e\u9875\u3002 \u7701\u7565 http:// \u6216 https:// \u65f6\uff0c\u89c4\u5219\u5339\u914d\u4e24\u79cd\u534f\u8bae\u3002"
      },
      "placeholder": "site.com\n*.site.com\nsite.com/page1\nhttp://192.0.2.10:8081/references/",
      "default": ""
    },
    {
      "key": "matching_mode",
      "type": "select",
      "label": {
        "en": "Which logins to show for the current page",
        "bg": "\u041a\u043e\u0438 \u0432\u0445\u043e\u0434\u043e\u0432\u0435 \u0434\u0430 \u0441\u0435 \u043f\u043e\u043a\u0430\u0437\u0432\u0430\u0442 \u0437\u0430 \u0442\u0435\u043a\u0443\u0449\u0430\u0442\u0430 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0430"
      },
      "default": "domain",
      "options": [
        {
          "value": "domain",
          "label": {
            "en": "Same domain",
            "bg": "\u0421\u044a\u0449\u0438\u044f \u0434\u043e\u043c\u0435\u0439\u043d"
          }
        },
        {
          "value": "exact",
          "label": {
            "en": "Exact address and path",
            "bg": "\u0422\u043e\u0447\u0435\u043d \u0430\u0434\u0440\u0435\u0441 \u0438 \u043f\u044a\u0442"
          }
        },
        {
          "value": "regex",
          "label": {
            "en": "Regular expression",
            "bg": "\u0420\u0435\u0433\u0443\u043b\u044f\u0440\u0435\u043d \u0438\u0437\u0440\u0430\u0437"
          }
        }
      ]
    }
  ],
  "distribution": {
    "chrome_store_url": null,
    "firefox_store_url": null
  }
}
